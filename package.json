    "react-dom": "19.2.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
